---
// Versione da stampare (o salvare in PDF) dei registri privacy — 12/11/2026.
// Solo amministratori: chi non lo è torna alla pagina di accesso. Mai in cache.
export const prerender = false;
import { sessionFromRequest } from "../../lib/auth.js";
import { REGISTRI, leggiRegistro, leggiStorico } from "../../lib/registri-privacy.js";

const session = sessionFromRequest(Astro.request);
if (!session || session.role !== "admin") return Astro.redirect("/admin");
Astro.response.headers.set("Cache-Control", "no-store");

const quale = REGISTRI.includes(Astro.url.searchParams.get("quale")) ? Astro.url.searchParams.get("quale") : "trattamenti";
const [righe, storico] = await Promise.all([leggiRegistro(quale), leggiStorico(quale, 500)]);
const attive = righe.filter((r) => r.stato !== "archiviato");
const archiviate = righe.filter((r) => r.stato === "archiviato");

const TITOLI = {
  trattamenti: { titolo: "Registro dei trattamenti", legge: "art. 30 del Regolamento (UE) 2016/679" },
  violazioni: { titolo: "Registro delle violazioni dei dati personali", legge: "art. 33, paragrafo 5, del Regolamento (UE) 2016/679" },
};
const T = TITOLI[quale];
const dataOra = (d) => new Date(d).toLocaleString("it-IT", { timeZone: "Europe/Rome", day: "numeric", month: "long", year: "numeric", hour: "2-digit", minute: "2-digit" });
const ultima = righe.reduce((m, r) => (new Date(r.updated_at) > new Date(m) ? r.updated_at : m), righe[0]?.updated_at || new Date().toISOString());
const AZIONI = { avviato: "", creata: "ha aggiunto", modificata: "ha modificato", archiviata: "ha archiviato", "rimessa in uso": "ha rimesso in uso" };
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{T.titolo} — InfermieriWeb.it</title>
    <style>
      * { box-sizing: border-box; }
      body { font-family: -apple-system, "Segoe UI", Arial, sans-serif; color: #10222e; margin: 0; background: #eef2f5; font-size: 15px; line-height: 1.5; }
      .barra { position: sticky; top: 0; background: #0b3954; color: #fff; padding: 12px 16px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
      .barra button { font: inherit; font-weight: 700; background: #fff; color: #0b3954; border: 0; border-radius: 999px; padding: 10px 20px; cursor: pointer; }
      .barra span { font-size: 14px; opacity: 0.9; }
      .foglio { background: #fff; max-width: 820px; margin: 18px auto; padding: 32px 36px; }
      h1 { font-size: 26px; margin: 0 0 4px; color: #0b3954; }
      .sotto { color: #4a6572; margin: 0 0 4px; }
      h2 { font-size: 18px; color: #0b3954; margin: 28px 0 8px; break-after: avoid; }
      h3 { font-size: 16px; color: #0b3954; margin: 34px 0 6px; padding-top: 14px; border-top: 2px solid #0b3954; }
      table { width: 100%; border-collapse: collapse; margin: 0 0 6px; }
      td { border: 1px solid #c9d6dc; padding: 7px 10px; vertical-align: top; overflow-wrap: anywhere; }
      td.voce { width: 30%; font-weight: 700; background: #f4f8f9; }
      td.testo { white-space: pre-wrap; }
      .mod { color: #5c7280; font-size: 12.5px; margin: 0 0 4px; }
      .storico td { font-size: 13px; padding: 5px 8px; }
      .piede { margin-top: 30px; color: #5c7280; font-size: 12.5px; border-top: 1px solid #c9d6dc; padding-top: 10px; }
      @media (max-width: 640px) { .foglio { margin: 0; padding: 20px 16px; } td.voce { width: 36%; } }
      @media print {
        body { background: #fff; font-size: 11.5pt; }
        .barra { display: none; }
        .foglio { margin: 0; padding: 0; max-width: none; }
        tr { break-inside: avoid; }
        @page { margin: 16mm 14mm; }
      }
    </style>
  </head>
  <body>
    <div class="barra">
      <button type="button" id="stampa">🖨️ Stampa o salva in PDF</button>
      <span>Nella finestra che si apre scegli «Salva come PDF» per avere il file.</span>
    </div>
    <div class="foglio">
      <h1>{T.titolo}</h1>
      <p class="sotto">InfermieriWeb.it — {T.legge}</p>
      <p class="sotto">Titolari del trattamento (contitolari): Eduard Gabriel Duduc e Bruno Ieppariello — info@infermieriweb.it</p>
      <p class="sotto">Ultima modifica: {dataOra(ultima)}. Copia stampata il {dataOra(new Date())} da {session.name || "amministratore"}.</p>

      {attive.length === 0 && <p>Nessuna riga nel registro.</p>}
      {attive.map((r) => (
        <section>
          <h2>{r.titolo}</h2>
          <p class="mod">Ultima modifica: {dataOra(r.updated_at)} — {r.updated_by || "—"}</p>
          <table>
            {(r.voci || []).map((v) => (<tr><td class="voce">{v.voce}</td><td class="testo">{v.contenuto || "— (da compilare)"}</td></tr>))}
          </table>
        </section>
      ))}

      {archiviate.length > 0 && <h3>Trattamenti non più in uso (archiviati)</h3>}
      {archiviate.map((r) => (
        <section>
          <h2>{r.titolo}</h2>
          <p class="mod">Archiviato il {dataOra(r.updated_at)} — {r.updated_by || "—"}</p>
          <table>
            {(r.voci || []).map((v) => (<tr><td class="voce">{v.voce}</td><td class="testo">{v.contenuto}</td></tr>))}
          </table>
        </section>
      ))}

      <h3>Storico delle modifiche</h3>
      <table class="storico">
        {storico.map((s) => (
          <tr>
            <td style="width: 34%;">{dataOra(s.at)}</td>
            <td>{s.azione === "avviato" ? s.titolo : `${s.admin} ${AZIONI[s.azione] || s.azione} «${s.titolo}»`}</td>
          </tr>
        ))}
      </table>

      <p class="piede">Documento interno: non si pubblica. Si esibisce al Garante per la protezione dei dati personali su richiesta. Il registro è tenuto in forma elettronica nel pannello di amministrazione di InfermieriWeb.it; ogni modifica è annotata con data, ora e autore.</p>
    </div>
    <script is:inline>
      document.getElementById("stampa").addEventListener("click", function () { window.print(); });
    </script>
  </body>
</html>
