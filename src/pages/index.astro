---
export const prerender = false;

import Platform from "../layouts/Platform.astro";
import HomeSearch from "../islands/HomeSearch.jsx";
import Icona from "../components/Icona.astro";
import HomeMap from "../components/HomeMap.astro";
import { getArticleImage } from "../utils/articleImageFallback.js";
import { organizationSchema, faqSchema } from "../data/schema.js";
import { sql } from "../lib/db.js";
import { mapArticolo } from "../lib/blog.js";
import { datiSuggerimenti } from "../lib/suggerimenti-server.js";

// Ultimi 6 articoli pubblicati, con l'autore se l'ha scritto un infermiere (8/10/26)
const righeArticoli = await sql`
  SELECT a.slug, a.title, a.category, a.excerpt, a.image, a.reading_time, a.published_at, a.sections,
         a.author_professional_id, p.name AS autore_nome, p.slug AS autore_slug, p.photo_url AS autore_foto,
         p.albo_name AS autore_albo, p.albo_number AS autore_numero, p.status AS autore_stato
  FROM articles a LEFT JOIN professionals p ON p.id = a.author_professional_id
  WHERE a.status = 'published' AND (a.author_professional_id IS NULL OR p.status <> 'deleted')
  ORDER BY a.published_at DESC, a.id DESC LIMIT 6`;
const ultimiArticoli = righeArticoli.map(mapArticolo);

// Suggerimenti del campo di ricerca (comuni coperti e prestazioni offerte): pochi KB
// direttamente nella pagina, così la tendina è pronta al primo tasto.
let indiceSuggerimenti = null;
try { indiceSuggerimenti = await datiSuggerimenti(); } catch { /* il campo li chiederà da solo */ }

const categorie = [
  { icona: "croce", nome: "Medicazioni", href: "/servizio/medicazioni" },
  { icona: "attivita", nome: "ECG a domicilio", href: "/servizio/ecg" },
  { icona: "provetta", nome: "Prelievi del sangue", href: "/servizio/prelievi" },
  { icona: "siringa", nome: "Iniezioni", href: "/servizio/iniezioni" },
  { icona: "cuore", nome: "Holter cardiaco", href: "/servizio/holter-cardiaci" },
  { icona: "indicatore", nome: "Holter pressorio", href: "/servizio/holter-pressori" },
  { icona: "goccia", nome: "Flebo e terapie", href: "/servizio/flebo" },
  { icona: "tubo", nome: "Cateteri e stomie", href: "/servizio/cateteri-vescicali" },
];

const faqItems = [
  { question: "Quanto costa un infermiere a domicilio?", answer: "Ogni professionista pubblica i suoi prezzi \"a partire da\" direttamente nella propria scheda, accanto a ciascuna prestazione: così conosci la cifra prima di prenotare. Il costo può variare in base alla complessità e alla distanza, e si paga direttamente all'infermiere dopo la prestazione." },
  { question: "Quanto costa prenotare su InfermieriWeb?", answer: "Nulla: la prenotazione è gratuita per il paziente. Il compenso della prestazione si regola direttamente con il professionista, ai prezzi indicati nella sua scheda." },
  { question: "Come si paga la prestazione?", answer: "Si paga direttamente al professionista, secondo le modalità che indica lui. Su InfermieriWeb non ci sono pagamenti online e non tratteniamo commissioni." },
  { question: "I professionisti sono verificati?", answer: "Sì: pubblichiamo solo professionisti iscritti al proprio albo (es. OPI per gli infermieri), verificati al momento dell'iscrizione." },
  { question: "Come funzionano le recensioni?", answer: "Solo chi ha completato una prenotazione riceve il link per lasciare una recensione: niente recensioni false, solo esperienze reali." },
  { question: "Posso disdire una prenotazione?", answer: "Sì, direttamente online dal link ricevuto alla conferma, fino a poche ore prima dell'appuntamento." },
];
---

<Platform
  title="Infermiere a domicilio: trova e prenota vicino a te | InfermieriWeb"
  description="Trova un infermiere a domicilio nella tua zona: prezzi chiari, recensioni verificate e prenotazione online in un minuto. Gratis per il paziente."
  path="/"
  schemas={[organizationSchema, faqSchema(faqItems)]}
>
  <section class="pf-hero pf-hero-split">
    <div class="pf-hero-testo">
      <span class="pf-hero-occhiello">Infermieri liberi professionisti a domicilio</span>
      <h1>Trova un infermiere a domicilio <span class="nowrap-desktop">nella tua zona</span></h1>
      <p class="sottotitolo">
        Prezzi chiari, recensioni verificate e solo orari davvero liberi. Prenoti in un minuto,
        senza registrazione e senza carta: <strong>paghi all'infermiere dopo la prestazione.</strong>
      </p>
      <HomeSearch client:load indice={indiceSuggerimenti} />
      <div class="pf-trust">
        <span class="pf-trust-item"><span class="i"><Icona nome="laurea" size={18} /></span> Iscritti all'OPI</span>
        <span class="pf-trust-item"><span class="i"><Icona nome="scudo" size={18} /></span> Assicurati (RC professionale)</span>
        <span class="pf-trust-item"><span class="i"><Icona nome="stella" size={18} /></span> Recensioni verificate</span>
        <span class="pf-trust-item"><span class="i"><Icona nome="etichetta" size={18} /></span> Prezzi chiari</span>
        <span class="pf-trust-item"><span class="i"><Icona nome="spunta" size={18} /></span> Zero commissioni</span>
      </div>
    </div>
    <div class="pf-hero-media">
      <img src="/hero-assistenza.webp" alt="Assistenza infermieristica a domicilio" width="1100" height="850" fetchpriority="high" />
      <span class="pf-hero-badge">✓ Iscrizione all'Albo verificata</span>
    </div>
  </section>

  <section class="pf-section pf-center">
    <span class="pf-kicker">Prestazioni</span>
    <h2>Di cosa hai bisogno?</h2>
    <p class="pf-sub">Prestazioni infermieristiche a casa tua, 7 giorni su 7. Prezzi chiari nella scheda di ogni professionista.</p>
    <div class="pf-cats">
      {categorie.map((c) => (
        <a class="pf-cat" href={c.href}>
          <span class="emoji"><Icona nome={c.icona} size={30} /></span>
          <span class="nome">{c.nome}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="pf-section alt">
    <div class="pf-container pf-center" style="margin-bottom: 40px;">
      <span class="pf-kicker">Perché sceglierci</span>
      <h2>Infermieri iscritti all'Albo, vicino a te</h2>
    </div>
    <div class="pf-perche">
      <div class="pf-perche-card">
        <div class="ic"><Icona nome="laurea" size={28} /></div>
        <h3>Iscrizione all'Albo verificata</h3>
        <p>Controlliamo l'iscrizione di ogni infermiere all'Albo (OPI) al momento dell'attivazione del profilo.</p>
      </div>
      <div class="pf-perche-card">
        <div class="ic"><Icona nome="stella" size={28} /></div>
        <h3>Recensioni vere</h3>
        <p>Solo chi ha completato una prenotazione può recensire: niente recensioni finte, solo esperienze reali.</p>
      </div>
      <div class="pf-perche-card">
        <div class="ic"><Icona nome="etichetta" size={28} /></div>
        <h3>Prezzi chiari</h3>
        <p>Vedi il prezzo "a partire da" prima di prenotare. Il compenso lo regoli direttamente col professionista.</p>
      </div>
      <div class="pf-perche-card">
        <div class="ic"><Icona nome="scudo" size={28} /></div>
        <h3>Zero commissioni</h3>
        <p>La prenotazione è gratuita per te e i professionisti restano indipendenti: nessun costo nascosto.</p>
      </div>
    </div>
  </section>

  <!-- 4. Guide e consigli (8/10/26: spostata qui, prima della mappa). Fila che si scorre
       col dito sul telefono, 3 per volta con le frecce sul computer. Tutto nell'HTML del
       server; lo script sotto accende solo le frecce. -->
  <section class="pf-section pf-center" id="guide" aria-labelledby="titolo-guide">
    <span class="pf-kicker">Blog salute</span>
    <h2 id="titolo-guide">Guide e consigli dei nostri infermieri</h2>
    <p class="pf-sub">Articoli chiari per pazienti e famiglie, scritti con gli infermieri della rete.</p>
    <div class="pf-guide" data-guide>
      <button type="button" class="pf-guide-freccia prec" aria-label="Articoli precedenti" disabled>
        <span aria-hidden="true">‹</span>
      </button>
      <ul class="pf-guide-fila" tabindex="0" aria-label="Ultimi articoli: scorri per vederne altri">
        {ultimiArticoli.map((articolo) => (
          <li class="pf-guide-voce">
            <a class="pf-guide-card" href={`/articoli/${articolo.slug}`}>
              <img class="pf-guide-copertina" src={getArticleImage(articolo)} alt={`Immagine dell'articolo: ${articolo.title}`} width="900" height="540" loading="lazy" decoding="async" />
              <span class="corpo">
                <span class="cat">{articolo.category}</span>
                <h3>{articolo.title}</h3>
                {articolo.autore ? (
                  <span class="pf-guide-autore">
                    <img src={articolo.autore.foto} alt="" width="36" height="36" loading="lazy" decoding="async" />
                    <span>{articolo.autore.nome}</span>
                  </span>
                ) : (
                  <span class="pf-guide-autore">
                    <img src="/logo-512.png" alt="" width="36" height="36" loading="lazy" decoding="async" />
                    <span>Redazione InfermieriWeb</span>
                  </span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
      <button type="button" class="pf-guide-freccia succ" aria-label="Articoli successivi">
        <span aria-hidden="true">›</span>
      </button>
    </div>
    <p style="margin-top: 22px;">
      <a class="pf-btn secondario" href="/articoli">Tutti gli articoli →</a>
    </p>
  </section>
  <script is:inline>
    (function () {
      document.querySelectorAll("[data-guide]").forEach(function (box) {
        var fila = box.querySelector(".pf-guide-fila");
        var prec = box.querySelector(".prec");
        var succ = box.querySelector(".succ");
        if (!fila || !prec || !succ) return;
        var aggiorna = function () {
          var max = fila.scrollWidth - fila.clientWidth - 2;
          box.classList.toggle("scorrevole", max > 0);
          prec.disabled = fila.scrollLeft <= 2;
          succ.disabled = fila.scrollLeft >= max;
        };
        var vai = function (verso) { fila.scrollBy({ left: verso * fila.clientWidth, behavior: "smooth" }); };
        prec.addEventListener("click", function () { vai(-1); });
        succ.addEventListener("click", function () { vai(1); });
        fila.addEventListener("scroll", aggiorna, { passive: true });
        window.addEventListener("resize", aggiorna);
        aggiorna();
      });
    })();
  </script>

  <section class="pf-section alt pf-center">
    <span class="pf-kicker">La rete</span>
    <h2>I professionisti sulla mappa</h2>
    <p class="pf-sub">La rete è partita da Lucca e si sta aprendo a nuove zone. Cerca la tua città o esplora la mappa.</p>
    <HomeMap />
    <p style="margin-top: 26px;">
      <a class="pf-btn" href="/cerca">Cerca nella tua zona</a>
    </p>
  </section>

  <section class="pf-section pf-center" id="come-funziona">
    <span class="pf-kicker">Come funziona</span>
    <h2>Prenoti in un minuto, senza account</h2>
    <div class="pf-steps" style="margin-top: 36px;">
      <div class="pf-step">
        <div class="num">1</div>
        <h3>Cerca nella tua zona</h3>
        <p>Scrivi la tua città e scopri i professionisti che coprono la tua zona, con foto, prezzi e recensioni.</p>
      </div>
      <div class="pf-step">
        <div class="num">2</div>
        <h3>Scegli prestazione e orario</h3>
        <p>Guarda il calendario con i soli orari realmente liberi e scegli quello comodo per te.</p>
      </div>
      <div class="pf-step">
        <div class="num">3</div>
        <h3>Conferma con nome e telefono</h3>
        <p>Niente registrazione e niente pagamenti online: il compenso si regola col professionista.</p>
      </div>
      <div class="pf-step">
        <div class="num">4</div>
        <h3>Ricevi la visita a casa</h3>
        <p>Il professionista arriva a domicilio. Dopo la prestazione potrai lasciare la tua recensione verificata.</p>
      </div>
    </div>
  </section>

  <section class="pf-section alt pf-center">
    <span class="pf-kicker">Domande frequenti</span>
    <h2>Le domande che ci fanno più spesso</h2>
    <div class="pf-faq">
      {faqItems.map((item) => (
        <details class="pf-faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="pf-section">
    <div class="pf-band">
      <div>
        <h2>Sei un infermiere libero professionista?</h2>
        <p>
          I pazienti della tua zona ti trovano su Google, prenotano sui tuoi orari reali e il
          compenso lo incassi tu, per intero. Zero commissioni.
          <strong>Gratis per i primi professionisti.</strong>
        </p>
        <p style="margin-top: 10px;">✍️ Puoi anche scrivere articoli firmati col tuo nome: dal tuo pannello.</p>
      </div>
      <a class="pf-btn" href="/lavora-con-noi">Voglio la mia scheda</a>
    </div>
  </section>
</Platform>
