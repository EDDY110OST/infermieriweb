---
export const prerender = false;

import Platform from "../../layouts/Platform.astro";
import ArticoloIsland from "../../islands/ArticoloIsland.jsx";
import { articleSeo } from "../../data/seo.js";
import { getArticleImage } from "../../utils/articleImageFallback.js";
import { organizationSchema, articleSchema, breadcrumbSchema, SITE_URL } from "../../data/schema.js";
import { sql } from "../../lib/db.js";
import { mapArticolo } from "../../lib/blog.js";
import { slugSostituto } from "../../lib/articoli-sostituiti.js";

const { slug } = Astro.params;

// Con l'autore, se l'ha scritto un infermiere (8/10/26). Mai un articolo firmato da un
// profilo eliminato (alla cancellazione tornano in bozza: questo è solo un secondo controllo).
const [riga] = await sql`
  SELECT a.slug, a.title, a.category, a.excerpt, a.image, a.reading_time, a.published_at, a.sections,
         a.sources, a.reviewed_at, a.author_professional_id,
         p.name AS autore_nome, p.slug AS autore_slug, p.photo_url AS autore_foto,
         p.albo_name AS autore_albo, p.albo_number AS autore_numero, p.status AS autore_stato
  FROM articles a LEFT JOIN professionals p ON p.id = a.author_professional_id
  WHERE a.slug = ${slug} AND a.status = 'published'
    AND (a.author_professional_id IS NULL OR p.status <> 'deleted')`;

if (!riga) {
  // Articolo sostituito (9/10/26): il vecchio indirizzo porta al nuovo articolo con un 301.
  // Si controlla qui, dopo la ricerca dell'articolo pubblicato, con lo stesso risultato che
  // controllandolo prima (un articolo sostituito non è mai pubblicato) e una query in meno
  // per ogni articolo normale. Sostituto non online → 404 come prima.
  const nuovo = await slugSostituto(slug);
  if (nuovo) return Astro.redirect(`/articoli/${nuovo}`, 301);
  return new Response(null, { status: 404 });
}
const article = mapArticolo(riga);

const correlateRighe = await sql`
  SELECT slug, title, category, excerpt, image, reading_time, published_at, sections
  FROM articles WHERE status = 'published' AND slug <> ${slug}
  ORDER BY published_at DESC, id DESC LIMIT 3`;
const related = correlateRighe.map(mapArticolo);

const seo = articleSeo(article);
const path = `/articoli/${slug}`;

const rawImage = getArticleImage(article);
const ogImage = rawImage.startsWith("data:") ? `${SITE_URL}/logo.jpeg` : new URL(rawImage, SITE_URL).href;

const schemas = [
  organizationSchema,
  articleSchema(article, ogImage),
  breadcrumbSchema([
    { name: "Home", url: `${SITE_URL}/` },
    { name: "Articoli", url: `${SITE_URL}/articoli` },
    { name: article.title, url: `${SITE_URL}${path}` },
  ]),
];
---

<Platform title={seo.title} description={seo.description} path={path} ogType="article" ogImage={ogImage} ogImageAlt={article.title} schemas={schemas}>
  <ArticoloIsland pathname={path} params={{ slug }} article={article} related={related} />
</Platform>

<!-- La pagina articolo è HTML statico (nessuna hydration): aggancio la stampa
     del modulo con uno script indipendente dal framework. -->
<script>
  document.addEventListener("click", (event) => {
    const el = event.target;
    if (el && el.closest && el.closest("[data-print]")) {
      event.preventDefault();
      window.print();
    }
  });
</script>
