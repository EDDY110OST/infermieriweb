---
import Base from "./Base.astro";
import "../styles/platform.css";
import logo from "../assets/logo.png";
import SocialBar from "../islands/SocialBar.jsx";
import { social } from "../data/social.js";
import { servicesData } from "../data/services.js";
import { NOMI_DOMICILIO, NOMI_COLLOQUIALI } from "../data/servizi-extra.js";
import { CONSULENZE } from "../data/consulenze.js";

const { title, description, path = "/", ogType, ogImage, ogImageAlt, schemas = [], manifest, robots } = Astro.props;
const current = path.replace(/\/$/, "") || "/";

// "Dove siamo" nel footer: le città reali della rete, dal database
// (statiche = aggiornate a ogni deploy; SSR = sempre fresche)
const slugifyFooter = (t) => t.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/['\s]+/g, "-").replace(/[^a-z0-9-]/g, "");
let cittaFooter = [];
try {
  const { sql } = await import("../lib/db.js");
  const zone = await sql`
    SELECT c.city, c.province, c.region, COUNT(*) AS n
    FROM coverage_areas c JOIN professionals p ON p.id = c.professional_id AND p.status = 'active'
      AND EXISTS (SELECT 1 FROM services WHERE professional_id = p.id AND active AND catalog_key NOT LIKE 'consulenza-%')
    GROUP BY 1, 2, 3 ORDER BY n DESC, c.city LIMIT 6`;
  cittaFooter = zone.map((z) => ({
    city: z.city,
    href: `/professionisti/${slugifyFooter(z.region)}/${slugifyFooter(z.province)}/${slugifyFooter(z.city)}`,
  }));
} catch { /* footer senza città se il DB non risponde */ }
// Menu (revisione soci 17/8/26): due tendine.
//  - "Prestazioni": due gruppi, per i PAZIENTI (a domicilio → /servizio/*) e per i
//    PROFESSIONISTI (consulenze a ora per colleghi → /consulenza/*).
//  - "Area professionisti": Accedi / Candidati + le info (perché iscriversi, consulenze).
// Le AZIONI restano i due pulsanti (Prenota, Richiedi informazioni).
const prestazioniPazienti = Object.entries(servicesData).map(([id, sv]) => ({
  href: `/servizio/${id}`, label: NOMI_DOMICILIO[id] || NOMI_COLLOQUIALI[id] || sv.title,
}));
const prestazioniProfessionisti = CONSULENZE.map((c) => ({ href: `/consulenza/${c.slug}`, label: c.titolo }));
const dentro = (prefissi) => prefissi.some((pre) => current === pre || current.startsWith(pre + "/"));
const attivoPrestazioni = dentro(["/domicilio", "/servizio", "/consulenza"]);
const attivoArea = dentro(["/area-professionisti", "/lavora-con-noi", "/per-i-professionisti"]);
---

<Base {title} {description} {path} {ogType} {ogImage} {ogImageAlt} {schemas} {manifest} {robots}>
  <div class="pf">
    <header class="pf-header">
      <div class="pf-header-inner">
        <a href="/" class="pf-logo" aria-label="InfermieriWeb - Home">
          <img src={logo.src} alt="InfermieriWeb.it" width="1734" height="426" />
        </a>
        <button class="pf-burger" aria-label="Apri il menu" aria-expanded="false" aria-controls="pf-nav">
          <span></span><span></span><span></span>
        </button>
        <nav class="pf-nav" id="pf-nav" aria-label="Menu principale">
          <a href="/come-funziona" aria-current={current === "/come-funziona" ? "page" : undefined}>Come funziona</a>

          <div class="pf-dd">
            <button type="button" class={`pf-dd-btn${attivoPrestazioni ? " attivo" : ""}`} aria-expanded="false" aria-haspopup="true" aria-controls="pf-dd-prestazioni">Prestazioni <span class="pf-dd-freccia" aria-hidden="true">▾</span></button>
            <div class="pf-dd-menu pf-dd-menu-2col" id="pf-dd-prestazioni">
              <div class="pf-dd-col">
                <a class="pf-dd-testa" href="/domicilio">Per i pazienti <small>a domicilio</small></a>
                {prestazioniPazienti.map((it) => (
                  <a href={it.href} aria-current={current === it.href ? "page" : undefined}>{it.label}</a>
                ))}
                <a class="pf-dd-tutte" href="/domicilio">Tutte le prestazioni a domicilio →</a>
              </div>
              <div class="pf-dd-col">
                <a class="pf-dd-testa" href="/consulenza">Per i professionisti <small>consulenze a ora</small></a>
                {prestazioniProfessionisti.map((it) => (
                  <a href={it.href} aria-current={current === it.href ? "page" : undefined}>{it.label}</a>
                ))}
                <a class="pf-dd-tutte" href="/consulenza">Tutte le consulenze →</a>
              </div>
            </div>
          </div>

          <a href="/articoli" aria-current={current === "/articoli" ? "page" : undefined}>Blog</a>

          <div class="pf-dd">
            <button type="button" class={`pf-dd-btn${attivoArea ? " attivo" : ""}`} aria-expanded="false" aria-haspopup="true" aria-controls="pf-dd-area">Area professionisti <span class="pf-dd-freccia" aria-hidden="true">▾</span></button>
            <div class="pf-dd-menu" id="pf-dd-area">
              <a class="pf-dd-azione" href="/area-professionisti">🔐 Accedi <small>hai già la tua scheda</small></a>
              <a class="pf-dd-azione" href="/lavora-con-noi">✍️ Candidati <small>gratis in fase di lancio</small></a>
              <div class="pf-dd-sep" role="separator"></div>
              <a href="/per-i-professionisti" aria-current={current === "/per-i-professionisti" ? "page" : undefined}>Perché iscriverti</a>
              <a href="/consulenza" aria-current={current === "/consulenza" ? "page" : undefined}>Consulenze per la libera professione</a>
              <a href="/articoli">Blog e guide</a>
            </div>
          </div>

          <a class="pf-cta" href="/cerca">Prenota</a>
          <a class="pf-cta pf-cta-ghost" href="/richiedi-informazioni" aria-current={current === "/richiedi-informazioni" ? "page" : undefined}>Richiedi informazioni</a>
          <SocialBar links={social} variant="header" size={19} />
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pf-footer">
      <div class="pf-footer-grid">
        <div>
          <h4>InfermieriWeb.it</h4>
          <p style="font-size:14.5px; margin:0; max-width:280px;">
            Infermieri liberi professionisti indipendenti, iscritti all'Albo (OPI):
            cresciamo una città alla volta, verificando l'iscrizione di ciascuno
            al momento dell'attivazione del profilo.
          </p>
        </div>
        <div>
          <h4>Per i pazienti</h4>
          <a href="/cerca">Trova un professionista</a>
          <a href="/come-funziona">Come funziona</a>
          <a href="/domicilio">Tutte le prestazioni</a>
          <a href="/professionisti">Zone coperte</a>
          <a href="/articoli">Blog salute</a>
          <a href="/le-mie-prenotazioni">Le mie prenotazioni (sposta o disdici)</a>
        </div>
        <div>
          <h4>Per i professionisti</h4>
          <a href="/per-i-professionisti">Perché iscriverti</a>
          <a href="/lavora-con-noi">Unisciti alla piattaforma</a>
          <a href="/area-professionisti">Area professionisti</a>
        </div>
        <div>
          <h4>Dove siamo</h4>
          {cittaFooter.map((c) => (
            <a href={c.href}>Infermiere a {c.city}</a>
          ))}
          <a href="/professionisti">Tutte le zone →</a>
        </div>
        <div>
          <h4>Informazioni</h4>
          <a href="/chi-siamo">Chi siamo</a>
          <a href="/recensioni">Recensioni</a>
          <a href="/contatti">Contatti e assistenza</a>
          <a href="/condizioni">Condizioni generali</a>
          <a href="/privacy">Privacy e cookie</a>
          <a href="/privacy#cookie" onclick="if(window.iwOpenCookiePrefs){window.iwOpenCookiePrefs();return false;}">Preferenze cookie</a>
        </div>
      </div>
      <div class="legal">
        <p style="margin:0 0 8px;">
          <strong>Titolari del trattamento e gestori di InfermieriWeb.it:</strong>
          Eduard Gabriel Duduc e Bruno Ieppariello (persone fisiche, in contitolarità ai sensi dell'art. 26 GDPR)
          — contatto: <a href="mailto:info@infermieriweb.it">info@infermieriweb.it</a>.
        </p>
        © 2026 InfermieriWeb.it — La prenotazione è gratuita per il paziente. Il compenso della prestazione
        viene regolato direttamente con il professionista. InfermieriWeb <strong>non fornisce prestazioni
        sanitarie</strong>: è una piattaforma tecnologica che mette in contatto pazienti e infermieri liberi
        professionisti indipendenti, iscritti all'Ordine (OPI). Il contratto della prestazione e il pagamento
        intercorrono direttamente tra paziente e professionista.
      </div>
    </footer>
  </div>

  <script is:inline>
    (function () {
      var burger = document.querySelector(".pf-burger");
      var nav = document.getElementById("pf-nav");
      if (burger && nav) {
        burger.addEventListener("click", function () {
          var open = nav.classList.toggle("open");
          burger.setAttribute("aria-expanded", open ? "true" : "false");
        });
      }
      // Tendine del menu. Col mouse si aprono al passaggio e si chiudono con un
      // RITARDO di mezzo secondo: tra bottone e menu ci sono 8px di stacco e la
      // gente ci passa sopra in diagonale — senza ritardo la tendina sparisce in
      // faccia (era il difetto segnalato il 17/8).
      // Col dito/click funzionano a toggle. Click fuori o Esc chiudono tutto.
      var tendine = Array.prototype.slice.call(document.querySelectorAll(".pf-dd"));
      var conMouse = window.matchMedia("(hover: hover) and (min-width: 1041px)");
      var timerChiusura = null;
      function mostra(dd, apri) {
        dd.classList.toggle("open", apri);
        var b = dd.querySelector(".pf-dd-btn");
        if (b) b.setAttribute("aria-expanded", apri ? "true" : "false");
      }
      function chiudiTutte(tranne) {
        tendine.forEach(function (dd) { if (dd !== tranne) mostra(dd, false); });
      }
      tendine.forEach(function (dd) {
        var btn = dd.querySelector(".pf-dd-btn");
        if (!btn) return;
        btn.addEventListener("click", function (e) {
          e.stopPropagation();
          clearTimeout(timerChiusura);
          var apri = !dd.classList.contains("open");
          mostra(dd, apri);
          chiudiTutte(dd);
        });
        dd.addEventListener("click", function (e) { e.stopPropagation(); });
        // Il menu è dentro .pf-dd: entrandoci si annulla la chiusura in corso.
        dd.addEventListener("mouseenter", function () {
          if (!conMouse.matches) return;
          clearTimeout(timerChiusura);
          mostra(dd, true);
          chiudiTutte(dd);
        });
        dd.addEventListener("mouseleave", function () {
          if (!conMouse.matches) return;
          clearTimeout(timerChiusura);
          timerChiusura = setTimeout(function () { mostra(dd, false); }, 500);
        });
      });
      document.addEventListener("click", function () { clearTimeout(timerChiusura); chiudiTutte(null); });
      document.addEventListener("keydown", function (e) { if (e.key === "Escape") chiudiTutte(null); });
    })();
  </script>
</Base>
